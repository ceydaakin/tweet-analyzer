# Required: Anthropic API key (https://platform.claude.com/settings/keys)
ANTHROPIC_API_KEY=

# Optional: model used for analysis (default: claude-opus-5)
# ANTHROPIC_MODEL=claude-opus-5

# Optional: save each analysis to Airtable. Set all three or none.
# Token needs data.records:write on the base (https://airtable.com/create/tokens)
AIRTABLE_TOKEN=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Table 1

# Optional
PORT=3001
# Max analyses per client IP per minute (each one is a paid Claude call)
RATE_LIMIT_PER_MINUTE=10
# Comma-separated list of allowed browser origins
CORS_ORIGIN=http://localhost:5173
